# Copia este archivo como .env y completa tus valores reales.
# NUNCA subas el archivo .env real al repositorio (contiene secretos).

# API oficial de Mistral (cloud)
MISTRAL_API_KEY=tu_api_key_de_mistral
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Información de la carrera
CARRERA_NOMBRE=Tecnologías de la Información en Línea (ITIV)
UNIVERSIDAD_NOMBRE=Universidad de las Fuerzas Armadas (ESPE)

# Información del director de carrera
DIRECTOR_NOMBRE=Director de Carrera
DIRECTOR_CORREO=carrera_itiv@espe.edu.ec

# Base de datos (PostgreSQL)
# Formato: postgresql+psycopg2://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URL=postgresql+psycopg2://postgres:rootroot@localhost:5432/chatbot

# Telegram Bot (obtener token con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram

# JWT (autenticación)
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
